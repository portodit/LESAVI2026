# --- Environment Configuration Example ---

# Environment
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:password@localhost:5432/lesavi_db

# Server Configuration
# WAJIB diisi dengan nilai acak yang belum pernah masuk git:
#   openssl rand -hex 32
# API refuses to start kalau SESSION_SECRET kosong.
SESSION_SECRET=ISI_DENGAN_HASIL_OPENSSL_RAND_HEX_32
LOG_LEVEL=info
PORT=3000

# Cookie session (dashboard login)
# true = hanya dikirim lewat HTTPS (wajib di produksi)
# false = untuk pengembangan lokal via http://localhost
COOKIE_SECURE=false

# Origin yang boleh memanggil API lintas origin (dipisah koma).
# Kosongkan kalau dashboard & API dilayani origin yang sama (produksi).
# PUBLIC_DOMAIN juga dipakai sebagai fallback whitelist.
CORS_ORIGINS=

# Domain publik (dipakai untuk link di pesan Telegram & whitelist CORS)
PUBLIC_DOMAIN=localhost
PUBLIC_DOMAIN_FALLBACK=localhost

# AI Integrations (Optional)
# AI_INTEGRATIONS_GEMINI_API_KEY=your_api_key_here
# AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Replit Specific (If applicable)
# REPLIT_DEV_DOMAIN=your-repl-domain.replit.app
